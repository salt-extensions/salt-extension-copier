[build-system]
requires = [
    "wheel",
    "setuptools>=50.3.2",
    "setuptools_scm[toml]>=3.4",
]
build-backend = "setuptools.build_meta"

[tool.setuptools_scm]
write_to = "src/{{ namespaced_package_path }}/version.py"
write_to_template = "__version__ = \"{version}\"\n"
fallback_version = "0.0.0"

[project]
name = "{{ package_namespace_pkg }}{{ project_name }}"
description = "{{ summary }}"
authors = [
    {name = "{{ author }}", email = "{{ author_email }}"},
]
keywords = [
    "salt-extension",
]
license = {text = "{{ license_name }}"}
classifiers = [
    "Programming Language :: Python",
    "Programming Language :: Cython",
    "Programming Language :: Python :: 3",
    "Programming Language :: Python :: 3 :: Only",
{%- for i in range(python_requires[1], max_python_minor + 1) %}
    "Programming Language :: Python :: 3.{{ i }}",
{%- endfor %}
    "Development Status :: 4 - Beta",
    "Intended Audience :: Developers",
{%- if license_classifier %}
    "{{ license_classifier }}",
{%- endif %}
{%- for os in os_support | select("in", os_meta) | sort %}
    "{{ os_meta[os]["classifier"] }}",
{%- endfor %}
]
requires-python = ">= {{ python_requires | join(".") }}"
dynamic = ["version"]
dependencies = [
    "salt>={{ salt_version }}",
]

[project.readme]
file = "README.md"
content-type = "text/markdown"

[project.urls]
Homepage = "{{ url }}"
{%- if docs_url %}
Documentation = "{{ docs_url }}"
{%- endif %}
{%- if source_url %}
Source = "{{ source_url }}"
{%- endif %}
{%- if tracker_url %}
Tracker = "{{ tracker_url }}"
{%- endif %}

[project.optional-dependencies]
changelog = ["towncrier=={{ versions["towncrier"] }}"]
dev = [
    "nox[uv]>=2024.3,!=2025.05.01",
    # prek is a fast drop-in replacement for pre-commit, but it only ships
    # prebuilt binaries for common platforms. Elsewhere (e.g. FreeBSD), the
    # dev automation falls back to pre-commit.
    "prek>=0.5.5 ; sys_platform == 'linux' or sys_platform == 'darwin' or sys_platform == 'win32'",
    "pre-commit>=2.21.0 ; sys_platform != 'linux' and sys_platform != 'darwin' and sys_platform != 'win32'",
]
# These dependencies are used in automations. It can be helpful
# to have them installed in the dev venv, e.g. for editor integration.
# When initializing the dev env using the included automation, pass
# `--extras` to install them automatically.
dev_extra = [
    "black=={{ versions["black"].split("#")[-1].strip() }}",
    "isort=={{ versions["isort"].split("#")[-1].strip() }}",
    "coverage=={{ versions["coverage"] }}",
]
docs = [
  "sphinx",
  "sphinx-prompt",
  "sphinx-copybutton",
  "towncrier=={{ versions["towncrier"] }}",
  "sphinxcontrib-towncrier",
  "myst_parser",
  "furo",
  "sphinx-inline-tabs",
]
docsauto = ["sphinx-autobuild"]
lint = [
    "pylint==4.0.9",
]
tests = [
    "pytest>=7.2.0",
{%- if test_containers %}
    "pytest-salt-factories>=1.0.0; sys_platform == 'win32'",
    "pytest-salt-factories[docker]>=1.0.0; sys_platform != 'win32'",
{%- else %}
    "pytest-salt-factories>=1.0.0",
{%- endif %}
    "pytest-instafail",
{%- if typing %}
    "typing-extensions>=4",
{%- endif %}
]

[project.entry-points."salt.loader"]
"{{ package_namespace_pkg }}{{ project_name }}" = "{{ namespaced_package_pkg }}"

[tool.setuptools]
zip-safe = false
include-package-data = true
platforms = ["any"]

[tool.setuptools.packages.find]
where = ["src"]
exclude = ["tests"]

[tool.distutils.bdist_wheel]
# Use this option if your package is pure-python
universal = 1

[tool.distutils.sdist]
owner = "root"
group = "root"

[tool.build_sphinx]
source_dir = "docs"
build_dir = "build/sphinx"

[tool.black]
line-length = 100

[tool.isort]
force_single_line = true
skip = ["src/{{ namespaced_package_path }}/__init__.py"]
profile = "black"
line_length = 100

[tool.towncrier]
package = "{{ namespaced_package_pkg }}"
filename = "CHANGELOG.md"
template = "changelog/.template.jinja"
directory = "changelog/"
start_string = "# Changelog\n"
underlines = ["", "", ""]
title_format = "## {version} ({project_date})"
{%- if tracker_url %}
issue_format = "[#{issue}]({{ tracker_url }}/{issue})"
{%- endif %}

[[tool.towncrier.type]]
directory = "breaking"
name = "Breaking changes"
showcontent = true

[[tool.towncrier.type]]
directory = "removed"
name = "Removed"
showcontent = true

[[tool.towncrier.type]]
directory = "deprecated"
name = "Deprecated"
showcontent = true

[[tool.towncrier.type]]
directory = "changed"
name = "Changed"
showcontent = true

[[tool.towncrier.type]]
directory = "fixed"
name = "Fixed"
showcontent = true

[[tool.towncrier.type]]
directory = "added"
name = "Added"
showcontent = true

[[tool.towncrier.type]]
directory = "security"
name = "Security"
showcontent = true

# While we currently don't use ruff for linting, it's helpful to include
# these settings in case a user has setup ruff in their editor environment.
[tool.ruff]
builtins = [
    "__active_provider_name__",
    "__context__",
    "__env__",
    "__events__",
    "__executors__",
    "__ext_pillar__",
    "__file_client__",
    "__grains__",
    "__instance_id__",
    "__jid__",
    "__jid_event__",
    "__low__",
    "__lowstate__",
    "__minion__",
    "__opts__",
    "__pillar__",
    "__proxy__",
    "__reg__",
    "__resource__",
    "__resource_funcs__",
    "__ret__",
    "__runner__",
    "__runners__",
    "__running__",
    "__salt__",
    "__salt_system_encoding__",
    "__sdb__",
    "__serializers__",
    "__states__",
    "__tag__",
    "__thorium__",
    "__user__",
]
{%- if typing %}

[tool.ty.environment]
# Ensure deterministic typechecking results regardless of the
# development platform. Unix-only APIs (e.g. `pwd`, `os.getuid`) are
# used behind runtime platform guards ty cannot narrow.
python-platform = "linux"

[tool.ty.rules]
missing-type-argument = "error"
possibly-unresolved-reference = "warn"

[tool.ty.src]
include = ["src", "tests"]
exclude = ["docs/conf.py", "noxfile.py", "tools/"]
{%- endif %}
