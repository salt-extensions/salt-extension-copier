{%- from pathjoin("includes", "workflows.j2") import expr -%}
{%- from pathjoin("includes", "test-jobs.yml.j2") import runner_test_job, vm_test_job with context -%}
---
name: Testing

on:
  workflow_call:
    inputs:
      use-caches:
        required: false
        type: boolean
        default: true
        description: Whether dependency caches may be used. Disabled for release builds.

jobs:
{%- if "Linux" in os_support %}
{%-   if "Ubuntu" in linux_test_distros %}
{#-     Keeps the historic `Linux` job ID, which existing repos may rely on
        for required status checks. -#}
{%-     if ubuntu_releases | length > 1 %}
{{ runner_test_job("Linux", "ubuntu-" ~ expr("matrix.osrelease"), timeout=30, full=true, releases=ubuntu_releases, cap=12) }}
{%-     else %}
{{ runner_test_job("Linux", "ubuntu-" ~ ubuntu_releases | first, timeout=30, full=true, cap=12) }}
{%-     endif %}
{%-   endif %}
{%-   set distro_releases = {
        "Debian": debian_releases,
        "Alpine": alpine_releases,
        "AlmaLinux": almalinux_releases,
        "Rocky Linux": rockylinux_releases,
      } %}
{%-   for distro, releases in distro_releases.items() if distro in linux_test_distros %}
{%-     set vm_meta = os_meta["Linux"]["distros"][distro]["vm"] %}
{{ vm_test_job(distro, vm_meta, releases, parametrized=not vm_meta.get("system_salt", false)) }}
{%-   endfor %}
{%- endif %}
{%- if "Windows" in os_support %}
{{ runner_test_job("Windows", "windows-" ~ versions["windows"], timeout=40, windows=true) }}
{%- endif %}
{%- if "macOS" in os_support %}
{{ runner_test_job("macOS", "macos-" ~ versions["macos"], timeout=40) }}
{%- endif %}
{%- if "FreeBSD" in os_support %}
{{ vm_test_job("FreeBSD", os_meta["FreeBSD"]["vm"], freebsd_releases) }}
{%- endif %}
{%- if "OpenBSD" in os_support %}
{{ vm_test_job("OpenBSD", os_meta["OpenBSD"]["vm"], openbsd_releases) }}
{%- endif %}
