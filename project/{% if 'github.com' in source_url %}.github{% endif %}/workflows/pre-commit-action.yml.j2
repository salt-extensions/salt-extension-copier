{%- from pathjoin("includes", "workflows.j2") import expr -%}
---
name: Pre-Commit

on:
  workflow_call:
    inputs:
      changed-files:
        required: true
        type: string
        description: JSON string containing information about changed files

permissions:
  contents: read

jobs:
  Pre-Commit:
    name: Pre-Commit
    runs-on: ubuntu-{{ versions["ubuntu"] }}
    container:
      image: {{ versions["prek_container"] }}

    steps:
      - uses: actions/checkout@{{ versions["actions/checkout"] }}

      - name: Cache Hook Environments
        # Release builds must not use cached environments. Enforced
        # service-side via `cache-mode: none` in the release workflows,
        # the tag ref check is an extra caller-independent safeguard.
        if: {{ expr("!startsWith(github.ref, 'refs/tags/')") }}
        uses: actions/cache@{{ versions["actions/cache"] }}
        with:
          path: ~/.cache/prek
          # Include the container digest to avoid restoring hook envs
          # built against a different Python installation.
          key: prek-{{ versions["prek_container"].split(":")[-1][:12] }}-{{ expr("hashFiles('.pre-commit-config.yaml')") }}

      # prek redirects UV_CACHE_DIR into its own cache, but the nox lint sessions (and ty, if enabled) don't
      - name: Cache uv Caches
        if: {{ expr("!startsWith(github.ref, 'refs/tags/')") }}
        uses: actions/cache@{{ versions["actions/cache"] }}
        with:
          path: ~/.cache/uv
          key: prek-uv-{{ versions["prek_container"].split(":")[-1][:12] }}-{{ expr("hashFiles('pyproject.toml', '.pre-commit-config.yaml')") }}
          restore-keys: |-
            prek-uv-{{ versions["prek_container"].split(":")[-1][:12] }}-

      - name: Install Prek Hooks
        run: |
          prek install-hooks

      - name: Check ALL Files On Branch
        if: github.event_name != 'pull_request' || fromJSON(inputs.changed-files)['pre-commit'] == 'true'
        run: |
          prek run --show-diff-on-failure --color=always --all-files

      - name: Check Changed Files On PR
        # Skip when the previous step already checked all files
        if: github.event_name == 'pull_request' && fromJSON(inputs.changed-files)['repo'] == 'true' && fromJSON(inputs.changed-files)['pre-commit'] != 'true'
        run: |
          prek run --show-diff-on-failure --color=always --files {{ expr("fromJSON(inputs.changed-files)['repo_files']") }}

      - name: Prune uv Cache
        if: {{ expr("always() && !startsWith(github.ref, 'refs/tags/')") }}
        run: uv cache prune --ci

      - name: Upload Exit Status
        if: always()
        uses: ./.github/actions/upload-exitstatus
