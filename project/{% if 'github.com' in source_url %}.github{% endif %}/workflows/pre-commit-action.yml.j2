{%- raw -%}
---
name: Pre-Commit

on:
  workflow_call:
    inputs:
      changed-files:
        required: true
        type: string
        description: JSON string containing information about changed files

permissions:
  contents: read

jobs:
  Pre-Commit:
    name: Pre-Commit
{%- endraw %}
    runs-on: ubuntu-{{ versions["ubuntu"] }}
    container:
      image: 'docker.io/library/python:{{ versions["python_container_" ~ (python_requires[:2] | join(""))] }}'
{%- raw %}

    steps:
      - name: Install System Deps
        run: |
          apt-get update
          apt-get install -y git gcc libc-dev
          git config --global --add safe.directory "$(pwd)"
{%- endraw %}

      - uses: actions/checkout@{{ versions["actions/checkout"] }}
{%- raw %}

      - name: Install Pre-Commit
        run: |
          python -m pip install --upgrade pip
          pip install pre-commit
          pre-commit install --install-hooks

      - name: Check ALL Files On Branch
        if: github.event_name != 'pull_request' || fromJSON(inputs.changed-files)['pre-commit'] == 'true'
        run: |
          pre-commit run --show-diff-on-failure --color=always --all-files

      - name: Check Changed Files On PR
        # Skip when the previous step already checked all files
        if: github.event_name == 'pull_request' && fromJSON(inputs.changed-files)['repo'] == 'true' && fromJSON(inputs.changed-files)['pre-commit'] != 'true'
        run: |
          pre-commit run --show-diff-on-failure --color=always --files ${{ fromJSON(inputs.changed-files)['repo_files'] }}

      - name: Upload Exit Status
        if: always()
        uses: ./.github/actions/upload-exitstatus
{%- endraw %}
