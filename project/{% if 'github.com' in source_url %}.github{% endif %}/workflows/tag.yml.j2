{%- from pathjoin("includes", "workflows.j2") import expr -%}
# Creates a new release.
# Triggered by pushing a tag beginning with `v`.
# The resulting version is taken from the tag.
# Fails if any news fragments are left over or the inferred version does not match the topmost changelog entry.
#
# Alternative to releasing by merging the autorelease PR.
---
name: Tagged Releases

on:
  push:
    tags:
      - "v*"  # Only tags starting with "v" for "v1.0.0", etc.

cache-mode: none

jobs:
  get_version_tag:
    name: Extract version from tag
    runs-on: ubuntu-{{ versions["ubuntu"] }}
    outputs:
      version: {{ expr("steps.get_version_tag.outputs.version") }}

    steps:
      - name: Checkout code
        uses: actions/checkout@{{ versions["actions/checkout"] }}

      - name: Extract version from tag name
        id: get_version_tag
        run: echo "version=${GITHUB_REF#refs/tags/v}" >> "$GITHUB_OUTPUT"

      - name: Ensure changelog was rendered
        env:
          VERSION: {{ expr("steps.get_version_tag.outputs.version") }}
        run: |
          test "$VERSION" = "$(python tools/version.py)" && \
          test -z "$(find changelog -type f -not -name '.*' -print -quit)"

      - name: Write version file
        env:
          VERSION: {{ expr("steps.get_version_tag.outputs.version") }}
        run: echo -n "$VERSION" > "$RUNNER_TEMP/version.txt"

      - name: Upload version
        uses: actions/upload-artifact@{{ versions["actions/upload-artifact"] }}
        with:
          archive: false
          path: {{ expr("runner.temp") }}/version.txt

  close_autopr_on_tag:
    name: Close release PR on manual tag
    runs-on: ubuntu-{{ versions["ubuntu"] }}
    permissions:
      # Allow closing the release PR and deleting its branch
      contents: write
      pull-requests: write
    needs:
      - get_version_tag

    steps:
      - name: Find Pull Request
        uses: juliangruber/find-pull-request-action@{{ versions["juliangruber/find-pull-request-action"] }}
        id: find-pull-request
        with:
          branch: release/auto
          base: {{ expr("github.event.repository.default_branch") }}
          state: open

      - name: Close release PR
        if: steps.find-pull-request.outputs.number != ''
        env:
          GH_TOKEN: {{ expr("secrets.GITHUB_TOKEN") }}
        run: |
          gh pr close \
            --comment "This release was triggered manually as v{{ expr("needs.get_version_tag.outputs.version") }}" \
            --delete-branch \
            --repo "$GITHUB_REPOSITORY" \
            "{{ expr("steps.find-pull-request.outputs.number") }}"

  call_central_workflow:
    needs:
      - get_version_tag
    uses: ./.github/workflows/ci.yml  # actionlint:ignore cache-operation -- release builds must not read caches
    # Release builds must not use cached environments (redundant with
    # the tag ref check in the cache steps, but explicit is better)
    cache-mode: none
    permissions:
      contents: read
      id-token: write
      pull-requests: read

  # Further jobs are run separately on `workflow_run` in deploy-package-action.yml
