{%- from pathjoin("includes", "workflows.j2") import expr -%}
# Publishes the built packages to Test PyPI and PyPI.
#
# This workflow is registered as the PyPI Trusted Publisher, meaning any job
# in this file with `id-token: write` can mint valid PyPI publish tokens.
# Keep it minimal: artifact verification and publishing only.
# Subsequent release steps run in finalize-release-action.yml.
---
name: Release Salt Extension Python Package

on:
  workflow_run:
    types:
      - completed
    workflows:
{%- if not require_autorelease_app %}
      # Without the autorelease app, merging the autorelease PR cannot cause
      # a tag push event, so `Auto PR Releases` runs the release pipeline itself.
      - Auto PR Releases
{%- endif %}
      - Tagged Releases

cache-mode: none

jobs:
  get_version:
    name: Get package version
    runs-on: ubuntu-{{ versions["ubuntu"] }}
    if: github.event.workflow_run.conclusion == 'success'
    permissions:
      actions: read
    outputs:
      version: {{ expr("steps.extract-version.outputs.version") }}

    steps:
{%- if not require_autorelease_app %}
      # When the autorelease app pushed the tag in tag-auto.yml, the release
      # runs via the tag push event in tag.yml instead, so the triggering
      # `Auto PR Releases` run does not produce any release artifacts and
      # this workflow has nothing to do.
      - name: Check triggering workflow for release artifacts
        id: check-artifacts
        env:
          GH_TOKEN: {{ expr("secrets.GITHUB_TOKEN") }}
          RUN_ID: {{ expr("github.event.workflow_run.id") }}
        run: |-
          artifacts="$(gh api "repos/$GITHUB_REPOSITORY/actions/runs/$RUN_ID/artifacts" --paginate --jq '.artifacts[].name')"
          if grep -qx 'version.txt' <<< "$artifacts" && grep -qx 'salt-extension-packages' <<< "$artifacts"; then
            echo "available=1" >> "$GITHUB_OUTPUT"
          else
            echo "available=0" >> "$GITHUB_OUTPUT"
            echo "::notice::No release artifacts found, assuming the release is handled by the tag push workflow."
          fi
{%- endif %}

      - name: Download expected version
        uses: actions/download-artifact@{{ versions["actions/download-artifact"] }}
{%- if not require_autorelease_app %}
        if: steps.check-artifacts.outputs.available == '1'
{%- endif %}
        with:
          name: version.txt
          path: {{ expr("runner.temp") }}
          github-token: {{ expr("secrets.GITHUB_TOKEN") }}
          run-id: {{ expr("github.event.workflow_run.id") }}

      - name: Download Python Package Artifacts
        uses: actions/download-artifact@{{ versions["actions/download-artifact"] }}
{%- if not require_autorelease_app %}
        if: steps.check-artifacts.outputs.available == '1'
{%- endif %}
        with:
          name: salt-extension-packages
          path: dist
          github-token: {{ expr("secrets.GITHUB_TOKEN") }}
          run-id: {{ expr("github.event.workflow_run.id") }}

      - name: Extract and verify package version
        id: extract-version
{%- if not require_autorelease_app %}
        if: steps.check-artifacts.outputs.available == '1'
{%- endif %}
        run: |-
          wheel_file="$(find dist -name '*.whl' | head -n 1)"
          test -n "$wheel_file" || exit 1
          unzip "$wheel_file" -d "$RUNNER_TEMP/extract"
          dist_info="$(find "$RUNNER_TEMP/extract" -type d -name '*.dist-info' | head -n 1)"
          test -n "$dist_info" || exit 1
          package_version="$(sed -n 's/^Version:\s*\(\S*\)$/\1/p' "$dist_info/METADATA")"
          test -n "$package_version" || exit 1
          expected_version="$(cat "$RUNNER_TEMP/version.txt" | head -n 1)"
          echo "Detected package version: $package_version"
          echo "Expected version: $expected_version"
          test "$package_version" = "$expected_version" || exit 1
          echo "version=$expected_version" >> "$GITHUB_OUTPUT"

      - name: Write release metadata
{%- if not require_autorelease_app %}
        if: steps.check-artifacts.outputs.available == '1'
{%- endif %}
        env:
          SOURCE_RUN_ID: {{ expr("github.event.workflow_run.id") }}
        run: |-
          mkdir "$RUNNER_TEMP/release-meta"
          cp "$RUNNER_TEMP/version.txt" "$RUNNER_TEMP/release-meta/version.txt"
          echo -n "$SOURCE_RUN_ID" > "$RUNNER_TEMP/release-meta/source-run-id.txt"

      - name: Upload release metadata
        # Consumed by finalize-release-action.yml, which handles the
        # remaining release steps after the packages were published.
        uses: actions/upload-artifact@{{ versions["actions/upload-artifact"] }}
{%- if not require_autorelease_app %}
        if: steps.check-artifacts.outputs.available == '1'
{%- endif %}
        with:
          name: release-meta
          path: {{ expr("runner.temp") }}/release-meta

      - name: Upload verified packages
        # The publish jobs download the packages from this run again,
        # ensuring they publish the exact bytes that were verified above.
        uses: actions/upload-artifact@{{ versions["actions/upload-artifact"] }}
{%- if not require_autorelease_app %}
        if: steps.check-artifacts.outputs.available == '1'
{%- endif %}
        with:
          name: salt-extension-packages
          path: dist

  test_release:
    name: Publish Python Package to Test PyPI
    runs-on: ubuntu-{{ versions["ubuntu"] }}
    needs:
      - get_version
{%- if not require_autorelease_app %}
    # Skip (together with all dependent jobs) when the triggering workflow
    # did not produce release artifacts (release handled via tag push event).
    if: needs.get_version.outputs.version != ''
{%- endif %}
    permissions:
      id-token: write

    steps:
      - name: Download verified packages
        uses: actions/download-artifact@{{ versions["actions/download-artifact"] }}
        with:
          name: salt-extension-packages
          path: dist

      - name: Publish distribution to Test PyPI
        uses: pypa/gh-action-pypi-publish@{{ versions["pypa/gh-action-pypi-publish"] }}
        with:
          attestations: {{ expr("secrets.TEST_PYPI_API_TOKEN == ''") }}
          password: {{ expr("secrets.TEST_PYPI_API_TOKEN") }}
          repository-url: https://test.pypi.org/legacy/
          verbose: {{ expr("runner.debug == '1'") }}

  pypi_release:
    name: Publish Python Package to PyPI
    runs-on: ubuntu-{{ versions["ubuntu"] }}
    needs:
      - test_release
    permissions:
      id-token: write
    environment:
      name: release
      url: https://pypi.org/p/{{ package_namespace_pkg }}{{ project_name }}

    steps:
      - name: Download verified packages
        uses: actions/download-artifact@{{ versions["actions/download-artifact"] }}
        with:
          name: salt-extension-packages
          path: dist

      - name: Publish distribution to PyPI
        uses: pypa/gh-action-pypi-publish@{{ versions["pypa/gh-action-pypi-publish"] }}
        with:
          attestations: {{ expr("secrets.PYPI_API_TOKEN == ''") }}
          password: {{ expr("secrets.PYPI_API_TOKEN") }}
          verbose: {{ expr("runner.debug == '1'") }}

  # The GitHub release and the docs deployment run separately on
  # `workflow_run` in finalize-release-action.yml.
