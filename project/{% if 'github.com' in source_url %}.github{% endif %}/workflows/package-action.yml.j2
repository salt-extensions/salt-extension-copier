{%- from pathjoin("includes", "workflows.j2") import expr -%}
---
name: Build Salt Extension Python Package

on:
  workflow_call:

permissions:
  contents: read

jobs:
  build:
    name: Build Python Packages (wheel and sdist)
    runs-on: ubuntu-{{ versions["ubuntu"] }}

    steps:
      - uses: actions/checkout@{{ versions["actions/checkout"] }}
        with:
          fetch-depth: 0

      - name: Set up Python {{ venv_python }}
        uses: actions/setup-python@{{ versions["actions/setup-python"] }}
        with:
          python-version: "{{ venv_python }}"

      - name: Install build tools
        run: python -m pip install build --user

      - name: Build Wheel
        run: python -m build --outdir dist/

      - name: Upload build artifacts
        uses: actions/upload-artifact@{{ versions["actions/upload-artifact"] }}
        with:
          name: salt-extension-packages
          path: dist/*
          retention-days: 5

      - name: Upload Exit Status
        if: {{ expr("!cancelled()") }}
        uses: ./.github/actions/upload-exitstatus
