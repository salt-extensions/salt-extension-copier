{%- from pathjoin("includes", "workflows.j2") import expr -%}
{%- set pyver = salt_python_support[salt_version_major]["max"][1] -%}
{%- set next_version = expr("(github.event_name == 'workflow_dispatch' && inputs.version != '') && inputs.version || steps.next-version.outputs.version") -%}
---
name: Prepare Release PR

on:
  workflow_call:
    secrets:
      AUTORELEASE_CLID:
        required: {{ require_autorelease_app | lower }}
      AUTORELEASE_PRIV:
        required: {{ require_autorelease_app | lower }}
  workflow_dispatch:
    inputs:
      version:
        description: Override the autogenerated version.
        required: false
        default: ''
        type: string

jobs:
  update-release:
    name: Render changelog and create/update PR
    runs-on: ubuntu-{{ versions["ubuntu"] }}
{%- if require_autorelease_app %}
    permissions:
      # The release branch and PR are managed using the autorelease app's token.
      contents: read
{%- else %}
    permissions:
      # Allow pushing the release branch and creating/updating the release PR
      # when falling back to the default token (no autorelease app configured)
      contents: write
      pull-requests: write
{%- endif %}
    if: github.ref == format('refs/heads/{0}', github.event.repository.default_branch)

    steps:
{%- if not require_autorelease_app %}
      # We support running with and without a dedicated app.
      # Registering a dedicated app allows CI to run on the release PR.
      - name: Check if autorelease app was setup
        id: check-app
        env:
          AUTORELEASE_CLID: {{ expr("secrets.AUTORELEASE_CLID") }}
          AUTORELEASE_PRIV: {{ expr("secrets.AUTORELEASE_PRIV") }}
        run: |-
          if [ -n "$AUTORELEASE_CLID" ] && [ -n "$AUTORELEASE_PRIV" ]; then
            echo "available=1" >> "$GITHUB_OUTPUT"
          else
            echo "available=0" >> "$GITHUB_OUTPUT"
          fi
{%- endif %}

      - name: Generate autorelease token
        uses: actions/create-github-app-token@{{ versions["actions/create-github-app-token"] }}
{%- if not require_autorelease_app %}
        if: steps.check-app.outputs.available == '1'
{%- endif %}
        id: generate-token
        with:
          app-id: {{ expr("secrets.AUTORELEASE_CLID") }}
          private-key: {{ expr("secrets.AUTORELEASE_PRIV") }}

      - name: Checkout code
        uses: actions/checkout@{{ versions["actions/checkout"] }}

      - name: Set up Python 3.{{ pyver }}
        uses: actions/setup-python@{{ versions["actions/setup-python"] }}
        with:
          python-version: '3.{{ pyver }}'

      - name: Install project
        run: |
          python -m pip install --upgrade pip
          python -m pip install '.[changelog]' pre-commit

      - name: Get next version
        if: github.event_name != 'workflow_dispatch' || inputs.version == ''
        id: next-version
        run: echo "version=$(python tools/version.py next)" >> "$GITHUB_OUTPUT"

      - name: Update CHANGELOG.md
        env:
          NEXT_VERSION: {{ next_version }}
        run: towncrier build --yes --version "${NEXT_VERSION}"

      - name: Run pre-commit once to remove trailing whitespace
        run: |
          python -m pre_commit run --files=CHANGELOG.md || true

      - name: Create/update release PR
        uses: peter-evans/create-pull-request@{{ versions["peter-evans/create-pull-request"] }}
        with:
{%- if require_autorelease_app %}
          token: {{ expr("steps.generate-token.outputs.token") }}
{%- else %}
          token: {{ expr("steps.check-app.outputs.available == '1' && steps.generate-token.outputs.token || github.token") }}
{%- endif %}
          commit-message: Release v{{ next_version }}
          branch: release/auto
          sign-commits: true
          labels: release
          title: Release v{{ next_version }}
          body: |-
            This automated PR builds the latest changelog. When merged, a new release is published automatically.

            Before merging, please ensure it's based on the most recent default branch HEAD.

            If you want to rebuild this PR with a custom version or the current date, you can also trigger the corresponding workflow manually in `Actions` > `Prepare Release PR` > `Run workflow`.

            You can still follow the manual release procedure outlined in: https://salt-extensions.github.io/salt-extension-copier/topics/publishing.html

      - name: Upload Exit Status
        if: always()
        uses: ./.github/actions/upload-exitstatus
