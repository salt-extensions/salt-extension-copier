---
minimum_pre_commit_version: 2.4.0
repos:
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: {{ versions["pre_commit_hooks"] }}
    hooks:
      - id: check-merge-conflict   # Check for files that contain merge conflict strings.
        args: [--assume-in-merge]
      - id: trailing-whitespace    # Trim trailing whitespace.
        args: [--markdown-linebreak-ext=md]
      - id: mixed-line-ending      # Ensure files use UNIX-style newlines only.
        args: [--fix=lf]
      - id: end-of-file-fixer      # Ensure files end with a newline.
      - id: check-ast              # Check whether files parse as valid Python.

  # ----- Formatting ---------------------------------------------------------------------------->
  - repo: https://github.com/saltstack/pre-commit-remove-import-headers
    rev: {{ versions["remove_import_headers"] }}
    hooks:
      - id: remove-import-headers

  - repo: local
    hooks:
      - id: check-cli-examples
        name: Check CLI examples on execution modules
        entry: python .pre-commit-hooks/check-cli-examples.py
        language: python
        files: ^src/{{ namespaced_package_path }}/(resources/[^/]+/)?modules/.*\.py$

  - repo: local
    hooks:
      - id: check-docs
        name: Check rST doc files exist for modules/states
        entry: python .pre-commit-hooks/make-autodocs.py
        language: python
        pass_filenames: false

  - repo: https://github.com/saltstack/salt-rewrite
    # Automatically rewrite code with known rules
    rev: {{ versions["salt_rewrite"] }}
    hooks:
      - id: salt-rewrite
        alias: rewrite-docstrings
        name: Salt extensions docstrings auto-fixes
        files: ^src/{{ namespaced_package_path }}/.*\.py$
        args: [--silent, -E, fix_tornado_imports]

  - repo: https://github.com/saltstack/salt-rewrite
    # Automatically rewrite code with known rules
    rev: {{ versions["salt_rewrite"] }}
    hooks:
      - id: salt-rewrite
        alias: rewrite-tests
        name: Rewrite the test suite
        files: ^tests/.*\.py$
        args: [--silent, -E, fix_docstrings, -E, fix_tornado_imports]

  - repo: https://github.com/asottile/pyupgrade
    rev: {{ versions["pyupgrade"] }}
    hooks:
      - id: pyupgrade
        name: Rewrite Code to be Py{{ python_requires[:2] | join(".") }}+
        args: [
          --py{{ python_requires[:2] | join("") }}-plus,
        ]
        exclude: src/{{ namespaced_package_path }}/version.py

  - repo: https://github.com/PyCQA/isort
    rev: {{ versions["isort"] }}
    hooks:
      - id: isort
        args: [
          --py={{ python_requires[:2] | join("") }},
        ]
        exclude: src/{{ namespaced_package_path }}/(__init__|version).py

  - repo: https://github.com/psf/black
    rev: {{ versions["black"] }}
    hooks:
      - id: black
        args: [-l 100]
        exclude: src/{{ namespaced_package_path }}/version.py

  - repo: https://github.com/adamchainz/blacken-docs
    rev: {{ versions["blacken_docs"] }}
    hooks:
      - id: blacken-docs
        args: [--skip-errors]
        files: ^(docs/.*\.rst|src/{{ namespaced_package_path }}/.*\.py)$
        additional_dependencies:
          - black=={{ versions["black"].split("#")[1].strip() }}
  # <---- Formatting -----------------------------------------------------------------------------

  # ----- Security ------------------------------------------------------------------------------>
  - repo: https://github.com/PyCQA/bandit
    rev: {{ versions["bandit"] }}
    hooks:
      - id: bandit
        alias: bandit-salt
        name: Run bandit against the code base
        args: [--silent, -lll, --skip, B701]
        exclude: src/{{ namespaced_package_path }}/version.py

  - repo: https://github.com/PyCQA/bandit
    rev: {{ versions["bandit"] }}
    hooks:
      - id: bandit
        alias: bandit-tests
        name: Run bandit against the test suite
        args: [--silent, -lll, --skip, B701]
        files: ^tests/.*
  # <---- Security -------------------------------------------------------------------------------

  # ----- Code Analysis ------------------------------------------------------------------------->

  - repo: local
    hooks:
      - id: nox
        alias: lint-src
        name: Lint Source Code
        language: python
        entry: nox -e lint-code --
        files: ^((setup|noxfile)|src/.*)\.py$
        require_serial: true
        additional_dependencies:
          - nox=={{ versions["nox"] }}
          # Speeds up this hook significantly and, since prek-created hook envs
          # don't include pip, provides the uv install path nox needs there.
          # uv only ships wheels for these platforms; elsewhere (e.g. FreeBSD),
          # the hooks run via pre-commit, whose envs include pip.
          - uv=={{ versions["uv"] }} ; sys_platform == 'linux' or sys_platform == 'darwin' or sys_platform == 'win32'

      - id: nox
        alias: lint-tests
        name: Lint Tests
        language: python
        entry: nox -e lint-tests --
        files: ^tests/.*\.py$
        require_serial: true
        additional_dependencies:
          - nox=={{ versions["nox"] }}
          - uv=={{ versions["uv"] }} ; sys_platform == 'linux' or sys_platform == 'darwin' or sys_platform == 'win32'

{%- if typing %}

      # Local reimplementation of the astral-sh/ty-pre-commit hook, which unconditionally
      # pins uv in `additional_dependencies`. This variant only installs the pin where
      # uv ships wheels and otherwise relies on a locally installed uv (as above).
      - id: ty
        alias: typing
        name: Typecheck Project
        language: python
        entry: uv check --quiet --preview-features=check-command --ty-version={{ versions["ty"] }}
        args:
          - --isolated
          - --extra=tests
        types_or: [python, pyi]
        pass_filenames: false
        always_run: true
        require_serial: true
        additional_dependencies:
          - uv=={{ versions["uv"] }} ; sys_platform == 'linux' or sys_platform == 'darwin' or sys_platform == 'win32'
{%- endif %}

{%- if "github.com" in source_url %}

  - repo: https://github.com/kjanat/actionlint
    rev: {{ versions["actionlint"] }}
    hooks:
      - id: actionlint-shellcheck
        alias: actionlint
{%- endif %}
  # <---- Code Analysis --------------------------------------------------------------------------
