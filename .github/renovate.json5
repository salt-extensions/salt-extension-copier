{
    prHourlyLimit: 10,
    enabledManagers: ["custom.regex", "dockerfile", "github-actions"],
    customManagers: [
        {
            customType: "regex",
            managerFilePatterns: ["/^noxfile\\.py$/"],
            matchStrings: [
                "# renovate: datasource=(?<datasource>pypi)(?: depType=(?<depType>[^\\s]+?))?(?: (?:lookupName|packageName)=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?\\s+[^\\n]*\"(?<depName>[A-Za-z0-9_\\-\\.]+?)\\s*==\\s*(?<currentValue>.+?)\",?\\s",
            ],
        },
        {
            customType: "regex",
            managerFilePatterns: ["/^data/salt_latest_point.yaml$/"],
            matchStrings: [
                "(?<major>\\d+): (?<minor>\\d+)\\s",
            ],
            currentValueTemplate: "{{{major}}}.{{{minor}}}",
            autoReplaceStringTemplate: "{{{newMajor}}}: {{{newMinor}}}\n",
            datasourceTemplate: "pypi",
            depTypeTemplate: "salt",
            packageNameTemplate: "salt",
        },
        {   // Dockerfile dev tool refs
            customType: "regex",
            managerFilePatterns: [
                "/^containers/.+\.Dockerfile$/",
            ],
            matchStrings: [
                // Generic versioned dependency
                // # renovate: datasource=foobar depName=... (lookupName/packageName=...) (versioning=...) (extractVersion=...) (depType=...)
                // ARG FOO_VERSION=1.2.3
                "# renovate: datasource=(?<datasource>[a-z-.]+?) depName=(?<depName>[^\\s]+?)(?: (?:lookupName|packageName)=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?(?: depType=(?<depType>[^\\s]+?))?\\s+ARG [A-Za-z0-9_/-]+?=(?<currentValue>[0-9.]+?)\\s",
            ],
            depTypeTemplate: "dev",
        },
    ],
    packageRules: [
        {
            // The salt dependency type is only for keeping the known point release up to date (used for generating the test workflow).
            // Major versions need to be added manually to the list in data/salt_latest_point.yaml.
            matchDepTypes: ["salt"],
            matchUpdateTypes: ["major"],
            enabled: false,
        },
        {   // Group all Salt point release updates.
            matchDepTypes: ["salt"],
            groupName: "Salt",
        },
        // We're building a custom prek container for a faster pre-commit workflow.
        // We want it to pin digests and to not upgrade minor versions.
        {
            matchPackageNames: ["python"],
            matchManagers: ["dockerfile"],
            pinDigests: true,
        },
        {   // This needs to be separate and before disabling minor updates.
            matchPackageNames: ["python"],
            matchManagers: ["dockerfile"],
            separateMinorPatch: true,
        },
        {   // Only update patch releases and pins/digests
            matchPackageNames: ["python"],
            matchManagers: ["dockerfile"],
            matchUpdateTypes: ["major", "minor"],
            enabled: false,
        },
        {   // Group everything that needs to be in the container and don't automerge updates.
            // We don't want to rebuild it often, likely only right before a new template release.
            matchPackageNames: ["python", "prek", "uv"],
            groupName: "CI Container",
            automerge: false,
        },
        {   // setup-uv `with: <uv_version>` should be managed by our manager
            // and not cause a separate PR (different package name, would be automerged)
            matchPackageNames: ["astral-sh/uv"],
            matchManagers: ["github-actions"],
            enabled: false,
        },
    ],
}
